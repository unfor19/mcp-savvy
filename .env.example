# =============================================================================
# mcp-savvy local config — copy to `.env` and fill in your values.
# `.env` is gitignored. Never commit real client IDs or tokens.
# =============================================================================
#
# Targets that read this file (via the Makefile's `include .env`):
#   make example-oidc-login   — run `mcp-savvy --login` against any IdP
#   make example-oidc-smoke   — initialize + tools/list + echo round-trip
#
# Targets that DO NOT read this file (they resolve env from CloudFormation
# outputs of the deployed McpSavvyDemoCognito / McpSavvyDemoRuntime stacks):
#   make example-minimal-login
#   make example-minimal-smoke

# -----------------------------------------------------------------------------
# Required for any IdP
# -----------------------------------------------------------------------------

# The Streamable-HTTP MCP endpoint the bridge will forward to.
# For an AgentCore Runtime, this is the Bedrock AgentCore /invocations URL
# (URL-encoded ARN). `make example-minimal-config` prints it for you.
MCP_SAVVY_REMOTE_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/...%2Finvocations?qualifier=DEFAULT

# OIDC issuer URL (the `iss` claim your IdP signs into the JWT).
MCP_SAVVY_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Public OIDC client ID (PKCE-only, no secret).
MCP_SAVVY_CLIENT_ID=<your-client-id>

# Provider preset:
#   - cognito (default)
#   - oidc    (any standards-compliant IdP: Entra, Okta, Auth0, Keycloak)
MCP_SAVVY_PROVIDER=oidc

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Override OAuth scopes (defaults to `openid email profile`).
# MCP_SAVVY_SCOPES=openid email profile offline_access

# Loopback callback port (default 33423). Must match a redirect URI
# registered with your IdP, e.g. http://localhost:33423/callback.
# MCP_SAVVY_CALLBACK_PORT=33423

# Loopback host the redirect URI advertises. Both `localhost` and
# `127.0.0.1` resolve to the same loopback interface; we default to
# `localhost` (project convention). Set this to `127.0.0.1` only if
# your IdP's registered redirect URI uses the literal IP form.
# MCP_SAVVY_CALLBACK_HOST=localhost

# Token namespace for the keychain. Default is derived from
# issuer+clientId so multiple deployments coexist on one host.
# MCP_SAVVY_TOKEN_NAMESPACE=my-org-prod

# Brand label rendered on the post-callback success page.
# MCP_SAVVY_BRAND_NAME=Acme Corp

# Verbose logs (1 = on).
# MCP_SAVVY_DEBUG=1

# Local data directory used by the encrypted-file keychain fallback and
# the per-namespace token lock (default `~/.mcp-savvy`). Override when
# running parallel test fixtures or sandboxes that share a host.
# MCP_SAVVY_DATA_DIR=~/.mcp-savvy

# Concurrent-client lock acquisition timeout (ms). How long a CLI
# instance waits to acquire the per-namespace token lock before giving
# up with LOCK_TIMEOUT.
# MCP_SAVVY_LOCK_TIMEOUT_MS=300000  # 1000–600000

# Lock staleness threshold (ms). Siblings treat a lock whose mtime is
# older than this as abandoned and reclaim it. Must be ≥ 3× the fixed
# 2000 ms heartbeat interval, which all in-range values satisfy.
# MCP_SAVVY_LOCK_STALE_MS=10000  # 5000–300000

# Graceful-shutdown deadline (ms). On SIGINT/SIGTERM the lock holder
# has this long to release its lock before the process exits anyway.
# MCP_SAVVY_SHUTDOWN_DEADLINE_MS=5000  # 100–30000

# -----------------------------------------------------------------------------
# Reference: Microsoft Entra ID setup
# -----------------------------------------------------------------------------
# 1. Azure Portal -> App registrations -> New registration
# 2. Supported account types: choose what fits your tenant
# 3. Authentication -> Add a platform -> "Mobile and desktop applications"
#    -> Custom redirect URI: http://localhost:33423/callback
# 4. Authentication -> Advanced -> "Allow public client flows" = Yes (PKCE)
# 5. Token configuration -> Add optional claim -> ID -> email
# 6. Expose an API -> Set the Application ID URI to `api://<clientId>`
#    -> Add a scope (e.g. `mcp.access`) so PKCE can request a token whose
#       `aud` is `api://<clientId>` (NOT Microsoft Graph). The Makefile
#       requests `api://<clientId>/.default` which packs in every scope
#       you've consented to.
# 7. Copy "Application (client) ID" to MCP_SAVVY_CLIENT_ID / ENTRA_CLIENT_ID
# 8. Copy "Directory (tenant) ID" to ENTRA_TENANT_ID

# -----------------------------------------------------------------------------
# Entra ID parallel deploy of minimal-mcp (Makefile reads these)
# -----------------------------------------------------------------------------
# Used by `make example-minimal-entra-deploy` and friends to build a
# parallel AgentCore Runtime gated by your Entra tenant's JWTs.

# Tenant (Directory) ID — find under Azure Portal -> Microsoft Entra ID
# ENTRA_TENANT_ID=<tenant-uuid>

# App registration's Application (client) ID
# ENTRA_CLIENT_ID=<client-uuid>

# Optional: explicit audience to validate. Defaults to api://$ENTRA_CLIENT_ID,
# which is what Entra issues when the client requests api://<clientId>/.default.
# ENTRA_AUDIENCE=api://<client-uuid>

# -----------------------------------------------------------------------------
# Reference: external SSO presets (Okta / Auth0 / Keycloak)
# -----------------------------------------------------------------------------
# These IdPs are wired in @mcp-savvy/cdk via oktaExternalOidc() /
# auth0ExternalOidc() / keycloakExternalOidc(). They are unit-tested but
# not yet live-deploy validated — there is no parallel `make` target for
# them yet (Entra is the validated reference path). For the bridge side,
# set the generic vars at the top of this file:
#   MCP_SAVVY_PROVIDER=oidc
#   MCP_SAVVY_OIDC_ISSUER=<issuer below>
#   MCP_SAVVY_CLIENT_ID=<public PKCE client id>
# Per-IdP setup (issuer shape, which claim carries the client id, quirks):
#   examples/identity-providers/README.md

# Okta — OIDC Native app (PKCE). Issuer is the custom authorization server
# (default), NOT the bare org domain. Client id rides in the `cid` claim;
# audience defaults to api://default.
#   issuer: https://<your-domain>.okta.com/oauth2/default
# OKTA_DOMAIN=<your-domain>.okta.com
# OKTA_CLIENT_ID=<public-client-id>
# OKTA_AUTH_SERVER_ID=default
# OKTA_AUDIENCE=api://default

# Auth0 — Native client (PKCE). You MUST pass an API Identifier as the
# audience; without it Auth0 returns an opaque token (not a JWT) that no
# authorizer can validate. Client id rides in the `azp` claim.
#   issuer: https://<your-tenant>.us.auth0.com/
# AUTH0_DOMAIN=<your-tenant>.us.auth0.com
# AUTH0_CLIENT_ID=<public-client-id>
# AUTH0_AUDIENCE=https://mcp.example.com

# Keycloak — public client with PKCE. Client id rides in `azp`; `aud` is
# not set to the client by default, so audience validation is skipped
# unless you add an audience mapper (then set KEYCLOAK_AUDIENCE).
#   issuer: https://<host>/realms/<realm>
# KEYCLOAK_BASE_URL=https://keycloak.example.com
# KEYCLOAK_REALM=<realm>
# KEYCLOAK_CLIENT_ID=<public-client-id>
# KEYCLOAK_AUDIENCE=

# -----------------------------------------------------------------------------
# Reference: AWS Cognito (the bundled minimal-mcp demo)
# -----------------------------------------------------------------------------
# Run `make example-minimal-config` after deploying — it prints the three
# required values from the live stack outputs. You can paste them here, or
# just use `make example-minimal-login` which reads CFN directly.

# -----------------------------------------------------------------------------
# gateway-3lo-mcp (architecture C): GitHub OAuth2 credential provider ARN
# -----------------------------------------------------------------------------
# `make example-gateway-3lo-deploy` reads this. Provision a GitHub OAuth2
# credential provider in AgentCore Identity once (it holds an IdP-side client
# secret and is shared across gateways), then point every example at its ARN.
# Format:
#   arn:aws:bedrock-agentcore:<region>:<account>:token-vault/default/oauth2credentialprovider/<name>
# MCP_SAVVY_GITHUB_OAUTH_PROVIDER_ARN=

# The deployed OAuthCompleteSessionApi POST endpoint, required on the bridge
# for any AgentCore Gateway 3LO target. `make example-gateway-3lo-config`
# prints it from the stack outputs (the construct exposes it as
# `completeSessionUrl`). Without it the bridge stays a verbatim forwarder
# and can't complete the second-leg OAuth dance.
# MCP_SAVVY_COMPLETE_SESSION_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/complete-session

# -----------------------------------------------------------------------------
# Tool-mode: how the bridge presents the upstream tool surface
# to the MCP host. Three values:
#   passthrough     - default. forward tools/list + tools/call verbatim.
#   search-local    - bridge caches schemas at startup, exposes two synthetic
#                     tools (${prefix}_search + ${prefix}_call). The search
#                     tool takes optional { provider?: enum, query?: string }
#                     — providers are auto-discovered from the upstream tool-
#                     name prefix (before '___') and exposed as a typed JSON-
#                     Schema enum. Query is tokenized + ranked against tool
#                     names+descriptions (camelCase-aware). Tiered fallback
#                     so the LLM never sees a bare empty list. Once warm,
#                     tools/list is served from cache — no upstream round-
#                     trips. No AWS billing.
#   search-gateway  - same two-tool surface, but ${prefix}_search forwards to
#                     the upstream gateway's x_amz_bedrock_agentcore_search.
#                     Requires gateway with searchType: SEMANTIC.
# MCP_SAVVY_TOOL_MODE=passthrough
#
# Whitelabel: rebrand the synthetic tools (default 'mcp_savvy'). Must match
# ^[a-z][a-z0-9_]*$ to stay a valid MCP identifier.
# MCP_SAVVY_TOOL_PREFIX=mcp_savvy

# -----------------------------------------------------------------------------
# chatgpt-app-mcp — banking-grade ChatGPT App (steps 3+ read these)
# -----------------------------------------------------------------------------
# `make example-chatgpt-app-deploy` reads these once the network stack lands.
# All three are required for step 3+; until then the example only deploys
# the Cognito + data stacks (which need none of these).
#
# FQDN the internal ALB serves on. CloudFront uses this as the origin
# domain so SNI matches the ACM cert.
# MCP_SAVVY_CHATGPT_APP_DOMAIN=chatgpt-app-mcp.example.com

# ACM cert ARN for the FQDN above. The cert MUST be in the same region
# as the deployment (us-east-1 by default). Wildcard certs covering the
# FQDN are accepted.
# MCP_SAVVY_CHATGPT_APP_CERT_ARN=arn:aws:acm:us-east-1:000000000000:certificate/...

# Route 53 hosted zone ID for the FQDN's parent zone. The stack creates
# an A-alias from the FQDN to the ALB. Leave unset to manage DNS by hand.
# MCP_SAVVY_CHATGPT_APP_HOSTED_ZONE_ID=Z000000000000
# MCP_SAVVY_CHATGPT_APP_HOSTED_ZONE_NAME=example.com

# AZ count (default 2; set to 1 for cheaper sandbox runs — breaks
# multi-AZ redundancy; production deployments should use at least two AZs).
# MCP_SAVVY_CHATGPT_APP_AZ_COUNT=2
