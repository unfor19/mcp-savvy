{
    "name": "chatgpt-app-mcp-animation",
    "version": "0.0.0",
    "private": true,
    "description": "Remotion animation of the chatgpt-app-mcp Pattern D request flow.",
    "type": "module",
    "scripts": {
        "studio": "remotion studio src/index.ts",
        "render": "remotion render src/index.ts PatternD out/pattern-d.mp4",
        "render:gif": "remotion render src/index.ts PatternD out/pattern-d.gif --codec=gif",
        "render:still": "remotion still src/index.ts PatternD out/pattern-d.png",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@remotion/cli": "4.0.477",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "remotion": "4.0.477"
    },
    "devDependencies": {
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "typescript": "5.6.3"
    },
    "engines": {
        "node": ">=20"
    }
}