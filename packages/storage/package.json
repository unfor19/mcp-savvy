{
    "name": "@mcp-savvy/storage",
    "version": "0.0.0",
    "private": true,
    "description": "Token storage for mcp-savvy: OS keychain with encrypted-file fallback.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@mcp-savvy/core": "workspace:*",
        "proper-lockfile": "^4.1.2"
    },
    "devDependencies": {
        "@types/proper-lockfile": "^4.1.4"
    }
}